# Идентификатор каталога Yandex Cloud (обязательно)
YANDEX_FOLDER_ID=

# Явный URI модели строится как gpt://<folder-id>/<model>
YANDEX_GPT_MODEL=yandexgpt-5-lite

# Только для локального запуска без IAM-токена Cloud Function
YANDEX_API_KEY=

LLM_TIMEOUT_MS=3200
LLM_MAX_TOKENS=180
LLM_TEMPERATURE=0.8
